{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaporstats",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaporstats-d1",
      "database_id": "vaporstats-d1-local",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

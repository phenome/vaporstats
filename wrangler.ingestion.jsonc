{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaporstats-ingestion",
  "main": "workers/ingestion.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaporstats-d1",
      "database_id": "ff783d33-5a97-4643-8221-16cd28e41626",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "vaporstats-ingestion-staging",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vaporstats-staging-d1",
          "database_id": "bddcda15-1f29-4d2b-980e-37e5b4a74bf3",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}

{
  "name": "vaporstats",
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images:optimize": "bun scripts/optimize-images.ts",
    "build": "bun scripts/optimize-images.ts && vite build",
    "start": "bun dist/server/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "test": "bun test",
    "check:types": "tsc --noEmit && echo TYPECHECK OK",
    "check:output": "bun scripts/check-output.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "verify": "tsc --noEmit && bun test && bun run build && bun run check:output && echo LAUNCH VERIFY OK"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.41.0",
    "posthog-js": "^1.427.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
